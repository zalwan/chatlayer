{
  "name": "@zalwan/chatlayer-svelte",
  "version": "0.1.1",
  "description": "Svelte UI components for ChatLayer — a provider-agnostic AI chat UI SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zalwan/chatlayer.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/zalwan/chatlayer#readme",
  "bugs": {
    "url": "https://github.com/zalwan/chatlayer/issues"
  },
  "keywords": [
    "svelte",
    "chat",
    "ai",
    "chatbot",
    "streaming",
    "ui",
    "component",
    "sdk"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@zalwan/chatlayer": "workspace:*",
    "dompurify": "^3.2.0",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.10",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/svelte": "^5.2.0",
    "jsdom": "^25.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["svelte"],
    "useDefineForClassFields": true,
    "paths": {
      "@chatlayer/core": ["../core/src/index.ts"],
      "@chatlayer/core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "src/**/*.js", "tests/**/*.ts"]
}

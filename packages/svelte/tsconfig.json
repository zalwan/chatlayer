{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["svelte"],
    "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "src/**/*.js", "tests/**/*.ts"]
}
